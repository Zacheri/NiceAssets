{
    "name": "atr/inventory",
    "description": "ATR local-network inventory management application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-gd": "*",
        "dompdf/dompdf": "^2.0 || ^3.0",
        "phpoffice/phpspreadsheet": "^2.0 || ^3.0",
        "endroid/qr-code": "^4.0 || ^5.0 || ^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
